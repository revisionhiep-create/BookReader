{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BookReader",
  "version": "1.1.0",
  "identifier": "com.bookreader.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BookReader",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' blob: data: http://bookmedia.localhost bookmedia: tauri:; img-src 'self' blob: data: http://bookmedia.localhost bookmedia: asset: https://asset.localhost; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost tauri: http://bookmedia.localhost bookmedia:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
